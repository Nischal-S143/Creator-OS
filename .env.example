# Copy to .env and fill in. Never commit .env.

APP_ENV=development
# Temporary guard for internal endpoints until user login exists. Generate a long random value.
INTERNAL_API_KEY=

# YugabyteDB. Use sslmode=verify-full and sslrootcert=PATH once the root certificate is in place.
DATABASE_URL=postgresql+psycopg://creatoros_app:PASSWORD@HOST:5433/yugabyte?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://creatoros_migrator:PASSWORD@HOST:5433/yugabyte?sslmode=require
# Used only for role setup and test schema setup. Do not set in staging or production app runtimes.
ADMIN_DATABASE_URL=postgresql+psycopg://admin:PASSWORD@HOST:5433/yugabyte?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Optional: pin the search_path (used by the integration tests)
# DB_SCHEMA=

# Gemini (server-side only, never sent to the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_S=30
# GEMINI_MAX_RETRIES=3
# GEMINI_MAX_CONCURRENCY=8

# Meko (server-side only; Phase 2)
# MEKO_API_KEY=
# MEKO_MCP_URL=https://mcp.mekodata.ai/mcp

# Auth provider (Phase 1; pending decision)
# AUTH_ISSUER=
# AUTH_AUDIENCE=

# Redis and Celery (Phase 0)
# REDIS_URL=redis://localhost:6379/0
